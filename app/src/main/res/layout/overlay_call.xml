<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tvOverlayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.02"
        android:text="Calling..."
        android:textColor="#CCFFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvOverlayName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        tools:text="John Doe" />

    <TextView
        android:id="@+id/tvOverlayNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:letterSpacing="0.03"
        android:textColor="#99FFFFFF"
        android:textSize="15sp"
        tools:text="+91XXXXXXXXXX" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlaySpeaker"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="Speaker"
                android:elevation="2dp"
                android:padding="18dp"
                android:src="@android:drawable/ic_lock_silent_mode_off" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Speaker"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlayMore"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="More"
                android:elevation="2dp"
                android:padding="18dp"
                android:src="@android:drawable/ic_menu_more" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="More"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlayMute"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="Mute"
                android:elevation="2dp"
                android:padding="18dp"
                android:src="@android:drawable/ic_btn_speak_now" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Mute"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlayHide"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="Hide"
                android:elevation="2dp"
                android:padding="20dp"
                android:src="@android:drawable/arrow_down_float" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Hide"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlayEnd"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_red"
                android:contentDescription="End call"
                android:elevation="4dp"
                android:padding="18dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="End"
                android:textColor="@android:color/white"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnOverlayKeypad"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_circle_translucent"
                android:contentDescription="Keypad"
                android:elevation="2dp"
                android:padding="18dp"
                android:src="@android:drawable/ic_dialog_dialer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="Keypad"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
